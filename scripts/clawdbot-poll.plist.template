<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.amux.clawdbot-poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SCRIPT_DIR__/clawdbot-poll.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.amux/logs/clawdbot.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.amux/logs/clawdbot.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
